// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"           // change to "postgresql" or "mysql" if you use those
  url      = env("DATABASE_URL")
}

model Product {
  id              Int    @id @default(autoincrement())
  name            String
  price           Int
  slug            String @unique
  lastBuyingPrice Int?
}

model Shop {
  id             Int             @id @default(autoincrement())
  name           String
  attendantShops AttendantShop[] // back relation
}

model Attendant {
  id             Int             @id @default(autoincrement())
  name           String
  attendantShops AttendantShop[] // back relation
}

model AttendantShop {
  id          Int       @id @default(autoincrement())
  attendant   Attendant @relation(fields: [attendantId], references: [id])
  attendantId Int
  shop        Shop      @relation(fields: [shopId], references: [id])
  shopId      Int

  @@unique([attendantId, shopId]) // one row per pair
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model Order {
  id     Int         @id @default(autoincrement())
  status OrderStatus
}
